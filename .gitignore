# ============================================================
# CatDex Monorepo .gitignore
# ============================================================

# ---- Node.js / Backend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---- Python / AI Service ----
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
*.pyo

# ---- Flutter / Dart ----
catdex_frontend/.dart_tool/
catdex_frontend/.packages
catdex_frontend/build/
catdex_frontend/.flutter-plugins
catdex_frontend/.flutter-plugins-dependencies
catdex_frontend/.pub-cache/
catdex_frontend/.pub/
catdex_frontend/pubspec.lock

# ---- Android ----
catdex_frontend/android/.gradle/
catdex_frontend/android/local.properties
catdex_frontend/android/key.properties
catdex_frontend/android/app/debug/
catdex_frontend/android/app/release/
catdex_frontend/android/app/*.jks
catdex_frontend/android/app/*.keystore

# ---- iOS ----
catdex_frontend/ios/Pods/
catdex_frontend/ios/.symlinks/
catdex_frontend/ios/Flutter/Flutter.framework
catdex_frontend/ios/Flutter/Flutter.podspec

# ---- IDEs ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/

# ---- Misc ----
*.zip
*.tar.gz
